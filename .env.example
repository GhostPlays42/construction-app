# Copy to .env.local and fill in from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Reads trucking slip photos. Create one at console.anthropic.com under API keys.
# Server only: never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# The nightly record keeping cleanup (vercel.json). Server only.
# CRON_SECRET: any long random string; Vercel sends it with each cron call.
# SUPABASE_SECRET_KEY: Supabase > Project Settings > API Keys > Secret keys.
CRON_SECRET=
SUPABASE_SECRET_KEY=
